{
  "name": "sandstorm-siege",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sandstorm Siege - a Middle-East themed detonation-chain slot",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim": "esbuild tools/sim.ts --bundle --platform=node --format=esm --outfile=.cache/sim.mjs && node .cache/sim.mjs",
    "test": "esbuild tools/engine.test.ts --bundle --platform=node --format=esm --outfile=.cache/engine.test.mjs && node --test .cache/engine.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
