# Copy to deploy/.env (never commit the real file).
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# The site's own address (no /api): Steam sends players back to <PUBLIC_URL>/auth/steam/return.
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
# Backoffice needs a TOTP step-up; comma-separated IPs/CIDRs may reach /admin and /mod (empty = anyone signed in as operator).
REQUIRE_OPERATOR_MFA=true
OPERATOR_IP_ALLOWLIST=
# "drand" for the public, trustless beacon (needs outbound HTTPS to api.drand.sh). With several API
# instances the local demo beacon only runs on the leader, which is fine for outcomes but not trustless.
BEACON=drand

# ---------- money mode ----------
# DEMO=false only with a gambling licence; the API refuses to start without LICENCE_ID.
DEMO=true
LICENCE_ID=
SITE_NAME=SCRAPLINE

# ---------- Steam sign-in ----------
# Web API key from https://steamcommunity.com/dev/apikey (domain = your site). Adds Steam name, avatar and
# profile link at sign-in. STEAM_LOGIN defaults to on when a key is set or outside the demo.
STEAM_API_KEY=
STEAM_LOGIN=

# ---------- skins (needs DEMO=false + LICENCE_ID) ----------
SKINS=false
# Credit per deposited item as a share of the market price; price factor for items taken out of stock.
DEPOSIT_RATE=1
WITHDRAW_RATE=1
# Cheapest accepted item in Frags (100 Frags = 1 $).
SKIN_MIN_ITEM=10
KYC_BEFORE_DEPOSIT=true
# Empty = Skinport's public Rust price list / Steam's community inventory endpoint ({steamid} is replaced).
PRICE_FEED_URL=
INVENTORY_URL=

# ---------- trade bot (docker compose --profile skins) ----------
# A separate Steam account with the Steam Guard Mobile Authenticator. shared_secret and identity_secret come
# from its maFile (e.g. Steam Desktop Authenticator). Never commit these values, never share the maFile.
BOT_ACCOUNT_NAME=
BOT_PASSWORD=
BOT_SHARED_SECRET=
# Only needed if an offer ever needs a mobile confirmation (deposit offers do not).
BOT_IDENTITY_SECRET=
